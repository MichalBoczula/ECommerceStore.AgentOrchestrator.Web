server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    location ~ ^/health/(live|ready)$ {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /entra-config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"tenantId":"${AO_ENTRA_TENANT_ID}","clientId":"${AO_ENTRA_CLIENT_ID}","apiClientId":"${AO_ENTRA_API_CLIENT_ID}"}';
    }

    location ~ ^/api/v1/runs(?:/|$) {
        proxy_pass ${AO_API_URL};
        proxy_http_version 1.1;
        proxy_set_header Authorization $http_authorization;
    }

    location /api/ {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
