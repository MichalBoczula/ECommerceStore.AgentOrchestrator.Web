{
  "name": "ecommerce-store-agent-orchestrator-web",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "^24.0.0" },
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.cjs",
    "build": "ng build",
    "format": "prettier --write 'src/**/*.{ts,html,scss}' 'e2e/**/*.ts' playwright.config.ts proxy.conf.cjs",
    "format:check": "prettier --check 'src/**/*.{ts,html,scss}' 'e2e/**/*.ts' playwright.config.ts proxy.conf.cjs",
    "generate:types": "npm exec --yes --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 -- openapi-typescript contracts/agent-orchestrator.v1.yaml -o src/app/features/runs/domain/contract.generated.ts && prettier --write src/app/features/runs/domain/contract.generated.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@azure/msal-browser": "5.30.0",
    "@fontsource/roboto": "^5.3.0",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
